[
  {
    "tool": "upsert_glyphs",
    "mutate": true,
    "glyph_file": "creative-glyphs.json",
    "save": "ligature-review/import.json"
  },
  {
    "tool": "set_ligatures",
    "mutate": true,
    "args": {
      "upsert": [
        {
          "feature": "dlig",
          "sequence": [
            "e",
            "c"
          ],
          "replacement": "e_c"
        },
        {
          "feature": "dlig",
          "sequence": [
            "i",
            "n"
          ],
          "replacement": "i_n"
        },
        {
          "feature": "dlig",
          "sequence": [
            "n",
            "a"
          ],
          "replacement": "n_a"
        },
        {
          "feature": "dlig",
          "sequence": [
            "o",
            "o"
          ],
          "replacement": "o_o"
        },
        {
          "feature": "dlig",
          "sequence": [
            "r",
            "t"
          ],
          "replacement": "r_t"
        }
      ]
    },
    "save": "ligature-review/rules.json"
  },
  {
    "tool": "set_kerning",
    "mutate": true,
    "args": {
      "upsert_pairs": [
        {
          "left": "R",
          "right": "e_c",
          "value": -25
        },
        {
          "left": "S",
          "right": "n_a",
          "value": -60
        },
        {
          "left": "F",
          "right": "o_o",
          "value": -80
        },
        {
          "left": "P",
          "right": "o_o",
          "value": -130
        },
        {
          "left": "T",
          "right": "o_o",
          "value": -160
        },
        {
          "left": "T",
          "right": "e_c",
          "value": -150
        }
      ]
    },
    "save": "ligature-review/kern.json"
  },
  {
    "tool": "validate_font_project",
    "args": {
      "temporary_build": true
    },
    "save": "ligature-review/validation.json"
  },
  {
    "tool": "build_font",
    "args": {
      "formats": [
        "ttf",
        "otf",
        "woff2"
      ]
    },
    "save": "ligature-review/build.json"
  }
]